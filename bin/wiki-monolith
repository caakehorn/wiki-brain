#!/usr/bin/env python3
"""wiki-monolith — the entire wiki as ONE document, at the smallest filesize.

Where bin/export-corpus makes a readable bundle and bin/llm-publish makes the
published per-page mirror, this makes the *single artifact*: every page in
wiki/, complete with frontmatter, in one file, losslessly, as small as the
format allows.

  bin/wiki-monolith --format csv    ONE .csv, smallest plain file (2.49 MB)
  bin/wiki-monolith --format txt --plain
                                    ONE .txt, no codecs (2.55 MB)
  bin/wiki-monolith                 .txt plus every available codec
  bin/wiki-monolith --best          also emit PPMd — smallest overall, 521 KB
  bin/wiki-monolith --compact       txt: path symbol table (uncompressed only)
  bin/wiki-monolith --all           every content tier x every codec
  bin/wiki-monolith --meta          include root governance/meta .md files
  bin/wiki-monolith --verify        check every artifact against the pages
  bin/wiki-monolith --out DIR       output directory (default exports/)

Which knob matters depends entirely on whether the output may be compressed,
and the two answers are opposites.

IF YOU CAN COMPRESS — compression is the only lever worth pulling. 2.55 MB
plain -> 521 KB PPMd order-16, 5.0:1, lossless (brotli 638 KB, text-tuned xz
644 KB, gzip 892 KB). Text-level cleverness is then wasted: symbol-
substituting the 442 repeated wiki/ paths saves 164 KB of plain text but only
6 KB of xz and nothing of PPMd, because a compressor already models that
redundancy better than a symbol table does.

IF IT MUST STAY A PLAIN .txt / .csv — those small levers are all there is,
and the ceiling is low. Measured, everything kept:

    TXT concat, no TOC                2.55 MB
    CSV, 'wiki/' prefix stripped      2.49 MB   <- smallest clean plain file
    TXT + path symbol table           2.40 MB   (lossless, but control chars)
    bodies only, no frontmatter       1.97 MB   (LOSSY — drops the claims)

CSV wins because 438 repeated YAML key names collapse into one header row
(-48 KB) while quote-doubling costs only 9.8 KB. Beyond that there is no
trick left: it is 2.5 MB of actual prose, and the only way materially
smaller is to drop content.

Dropping frontmatter is the one big cut available, and it is a bad trade:
23% of raw bytes but only 11% of compressed size, and the typed connections:
edges living there carry argued claims -- earned content, not boilerplate.
So nothing is dropped by default in any format.

--verify checks txt byte-for-byte against every page. CSV is a
restructuring, so it is verified on content instead: every row present,
every body exact, every frontmatter value recoverable.
"""
import argparse
import datetime
import gzip
import io
import lzma
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
WIKI = ROOT / "wiki"
SKIP_DIRS = {".obsidian"}

# Sentinels chosen to be absent from the corpus: page delimiter, and the
# symbol-table terminator used by --compact.
PAGE = "\x1e===== "
SYMBOL_END = "\x02\n"

XZ_TEXT = [{"id": lzma.FILTER_LZMA2, "preset": 9 | lzma.PRESET_EXTREME,
            "lc": 4, "pb": 0, "dict_size": 1 << 26}]


def pages(include_meta=False):
    out = []
    for p in sorted(WIKI.rglob("*.md")):
        if not any(part in SKIP_DIRS for part in p.parts):
            out.append(p)
    if include_meta:
        for name in sorted(p.name for p in ROOT.glob("*.md")):
            out.append(ROOT / name)
    return out


def title_of(text, fallback):
    for line in text.splitlines():
        if line.startswith("# "):
            return line[2:].strip()
    return fallback


def build(files, toc=True):
    """Concatenate every page into one document. Lossless and splittable."""
    bodies = []
    entries = []
    for p in files:
        rel = p.relative_to(ROOT).as_posix()
        text = p.read_text(encoding="utf-8", errors="replace")
        # The split/verify round-trip assumes these control chars never occur
        # in page text. Fail loudly rather than silently corrupting a page.
        for ch, name in (("\x1e", "U+001E"), ("\x01", "U+0001"), ("\x02", "U+0002")):
            if ch in text:
                raise SystemExit(f"{rel} contains sentinel {name}; "
                                 "choose a different delimiter before exporting")
        entries.append((rel, title_of(text, rel)))
        bodies.append(f"{PAGE}{rel} =====\n{text}")

    head = [
        "WIKI-BRAIN — COMPLETE CORPUS, SINGLE DOCUMENT",
        f"generated {datetime.date.today().isoformat()} · {len(files)} pages",
        "",
        "Every page of the wiki, complete with YAML frontmatter, concatenated",
        "losslessly. Pages are delimited by a line beginning with the record",
        "separator U+001E followed by '===== <path> ====='. Frontmatter carries",
        "the typed `connections:` edges and their argued claims — that is",
        "content, not metadata, and is reproduced in full.",
        "",
    ]
    if toc:
        head.append("CONTENTS")
        head += [f"  {rel} — {t}" for rel, t in entries]
        head.append("")
    return "\n".join(head) + "".join(bodies)


def compact(doc):
    """Replace repeated wiki/ paths with short symbols + a legend. Lossless.

    Worth ~6% of the plain text and roughly nothing after compression.
    """
    counts = {}
    for m in re.findall(r"wiki/[a-z0-9\-/]+", doc):
        counts[m] = counts.get(m, 0) + 1
    worth = [p for p, n in sorted(counts.items(), key=lambda kv: -kv[1] * len(kv[0]))
             if n > 2 and len(p) > 10]
    # Fixed-width hex ids: variable-width ones are prefixes of each other
    # (\x011 vs \x0110) and expansion would corrupt the longer reference.
    width = max(3, len(f"{max(len(worth) - 1, 0):x}"))
    table = {p: f"\x01{i:0{width}x}" for i, p in enumerate(worth)}
    for p in sorted(worth, key=len, reverse=True):
        doc = doc.replace(p, table[p])
    legend = "".join(f"{sym}\t{path}\n" for path, sym in table.items())
    return (f"SYMBOL TABLE — {len(table)} paths abbreviated; each \\x01 followed by\n"
            f"{width} hex digits expands to the path on its right. Ends at \\x02.\n"
            + legend + SYMBOL_END + doc)


def expand(doc):
    """Inverse of compact()."""
    if SYMBOL_END not in doc:
        return doc
    legend, body = doc.split(SYMBOL_END, 1)
    for line in legend.splitlines():
        if "\t" in line and line.startswith("\x01"):
            sym, path = line.split("\t", 1)
            body = body.replace(sym, path)
    return body


def codecs(best=False):
    """Available codecs, smallest-capable last."""
    out = [
        ("txt", "plain", lambda b: b, lambda b: b),
        ("txt.gz", "gzip -9", lambda b: gzip.compress(b, 9), gzip.decompress),
        ("txt.xz", "xz -9e (text-tuned)",
         lambda b: lzma.compress(b, format=lzma.FORMAT_XZ, filters=XZ_TEXT),
         lzma.decompress),
    ]
    try:
        import brotli
        out.append(("txt.br", "brotli q11",
                    lambda b: brotli.compress(b, quality=11, lgwin=24),
                    brotli.decompress))
    except ImportError:
        pass
    if best:
        try:
            import pyppmd
            out.append(("txt.ppmd", "PPMd H order-16",
                        lambda b: pyppmd.compress(b, max_order=16, mem_size=1 << 27),
                        lambda b: pyppmd.decompress(b, max_order=16, mem_size=1 << 27)))
        except ImportError:
            print("note: --best needs pyppmd (pip install pyppmd); skipping PPMd",
                  file=sys.stderr)
    return out


def human(n):
    return f"{n/1024/1024:.2f} MB" if n >= 1 << 20 else f"{n/1024:.0f} KB"


# Frontmatter keys promoted to their own CSV column. Anything not listed
# still ships, in the catch-all `other_frontmatter` column, so no field is
# ever silently dropped.
CSV_COLS = ["domain", "page_type", "status", "knowledge", "importance",
            "title", "aliases", "tags", "date_created", "date_modified",
            "date_range_start", "date_range_end", "sources", "connections",
            "synthesizes", "related"]


def parse_fm(fm):
    """Split YAML frontmatter into {key: value}, values kept verbatim.

    Deliberately dumb: it only needs to recognise top-level `key:` lines and
    keep everything beneath them untouched, so nested structures like
    connections: survive as their original text.
    """
    out, cur = {}, None
    for line in fm.split("\n"):
        m = re.match(r"^([A-Za-z_][A-Za-z0-9_]*):\s?(.*)$", line)
        if m:
            cur = m.group(1)
            out[cur] = m.group(2)
        elif cur is not None and (line.startswith((" ", "\t", "-")) or not line.strip()):
            out[cur] += "\n" + line
    return {k: v.strip("\n") for k, v in out.items()}


def build_csv(files, strip_prefix=True):
    """One row per page. Smaller than TXT: the repeated YAML key names
    collapse into a single header row."""
    import csv as _csv
    buf = io.StringIO()
    w = _csv.writer(buf, lineterminator="\n")
    w.writerow(["path"] + CSV_COLS + ["other_frontmatter", "body"])
    for p in files:
        rel = p.relative_to(ROOT).as_posix()
        fm, body = split_frontmatter(p.read_text(encoding="utf-8", errors="replace"))
        d = parse_fm(fm)
        extra = "\n".join(f"{k}: {v}" for k, v in d.items() if k not in CSV_COLS)
        row = [rel] + [d.get(c, "") for c in CSV_COLS] + [extra, body]
        if strip_prefix:
            row = [c.replace("wiki/", "") for c in row]
        w.writerow(row)
    return buf.getvalue()


def split_frontmatter(t):
    if t.startswith("---\n"):
        e = t.find("\n---\n", 4)
        if e != -1:
            return t[4:e], t[e + 5:]
    return "", t


def verify_csv(text, files, strip_prefix=True):
    """Content check, not a byte check: every page present, every body and
    every frontmatter value recoverable from its row."""
    import csv as _csv
    rows = list(_csv.reader(io.StringIO(text)))
    header, rows = rows[0], rows[1:]
    if len(rows) != len(files):
        print(f"  FAIL row count {len(rows)} != {len(files)} pages")
        return False
    ok = True
    bi, pi = header.index("body"), header.index("path")
    for row, p in zip(rows, files):
        rel = p.relative_to(ROOT).as_posix()
        fm, body = split_frontmatter(p.read_text(encoding="utf-8", errors="replace"))
        if strip_prefix:
            body, fm = body.replace("wiki/", ""), fm.replace("wiki/", "")
        if row[pi] != (rel.replace("wiki/", "") if strip_prefix else rel):
            print(f"  FAIL path mismatch: {rel}")
            ok = False
        if row[bi] != body:
            print(f"  FAIL body mismatch: {rel}")
            ok = False
        for k, v in parse_fm(fm).items():
            col = header.index(k) if k in header else header.index("other_frontmatter")
            if v.strip() and v.strip() not in row[col]:
                print(f"  FAIL missing frontmatter {k}: {rel}")
                ok = False
    return ok


def main(argv=None):
    ap = argparse.ArgumentParser(add_help=False)
    ap.add_argument("--out", default=str(ROOT / "exports"))
    ap.add_argument("--best", action="store_true")
    ap.add_argument("--compact", action="store_true")
    ap.add_argument("--all", action="store_true")
    ap.add_argument("--meta", action="store_true")
    ap.add_argument("--no-toc", action="store_true")
    ap.add_argument("--verify", action="store_true")
    ap.add_argument("--format", choices=["txt", "csv", "both"], default="txt")
    ap.add_argument("--plain", action="store_true",
                    help="write only the uncompressed file, no codecs")
    ap.add_argument("--keep-prefix", action="store_true",
                    help="csv: keep the redundant 'wiki/' on every path")
    ap.add_argument("-h", "--help", action="store_true")
    a = ap.parse_args(argv)
    if a.help:
        print(__doc__)
        return 0

    files = pages(a.meta)
    if not files:
        print("no pages found", file=sys.stderr)
        return 1
    doc = build(files, toc=not a.no_toc)
    raw = doc.encode()
    source_bytes = sum(p.stat().st_size for p in files)

    if a.all:
        return report_all(doc, files, source_bytes)

    outdir = Path(a.out)
    outdir.mkdir(parents=True, exist_ok=True)
    stem = f"wiki-monolith_{datetime.date.today().isoformat()}"

    print(f"{len(files)} pages · {human(source_bytes)} on disk\n")
    print(f"{'artifact':<34}{'size':>12}{'ratio':>9}")
    print("-" * 55)

    if a.format in ("csv", "both"):
        text = build_csv(files, strip_prefix=not a.keep_prefix)
        cpath = outdir / f"{stem}.csv"
        cpath.write_text(text, encoding="utf-8")
        print(f"{cpath.name:<34}{human(len(text.encode())):>12}"
              f"{len(raw)/len(text.encode()):>8.1f}x")
        if a.verify:
            ok = verify_csv(text, files, strip_prefix=not a.keep_prefix)
            print(f"  csv: {len(files)} rows · "
                  f"{'all bodies + frontmatter present' if ok else 'ERRORS ABOVE'}")
            if not ok:
                return 1
        if a.format == "csv":
            print(f"\nsmallest: {cpath.name} — {human(len(text.encode()))}")
            return 0

    if a.plain:
        ppath = outdir / f"{stem}.txt"
        payload = compact(doc) if a.compact else doc
        ppath.write_text(payload, encoding="utf-8")
        print(f"{ppath.name:<34}{human(len(payload.encode())):>12}"
              f"{len(raw)/len(payload.encode()):>8.1f}x")
        return 0

    written = []
    for ext, label, enc, dec in codecs(a.best):
        payload = doc
        if ext == "txt" and a.compact:
            payload = compact(doc)
        blob = enc(payload.encode())
        path = outdir / f"{stem}.{ext}"
        path.write_bytes(blob)
        written.append((path, label, dec, payload))
        print(f"{path.name:<34}{human(len(blob)):>12}{len(raw)/len(blob):>8.1f}x")

    if a.verify:
        print("\nverifying round-trip …")
        ok = True
        for path, label, dec, payload in written:
            back = dec(path.read_bytes()).decode()
            if expand(back) != doc:
                print(f"  FAIL {path.name}")
                ok = False
        # and that every page is recoverable byte-for-byte from the document
        recovered = 0
        for chunk in doc.split(PAGE)[1:]:
            rel, text = chunk.split(" =====\n", 1)
            original = (ROOT / rel).read_text(encoding="utf-8", errors="replace")
            if text != original:
                print(f"  FAIL page mismatch: {rel}")
                ok = False
            recovered += 1
        print(f"  {recovered}/{len(files)} pages byte-identical · "
              f"{'ALL ARTIFACTS LOSSLESS' if ok else 'ERRORS ABOVE'}")
        if not ok:
            return 1

    smallest = min(written, key=lambda w: w[0].stat().st_size)
    print(f"\nsmallest: {smallest[0].name} ({smallest[1]}) — "
          f"{human(smallest[0].stat().st_size)}")
    if not a.best:
        print("try --best for PPMd, ~19% below xz")
    return 0


def report_all(doc, files, source_bytes):
    """Every content tier x every codec — the measurement behind the defaults."""
    def split_fm(t):
        if t.startswith("---\n"):
            e = t.find("\n---\n", 4)
            if e != -1:
                return t[4:e], t[e + 5:]
        return "", t

    parts = [(p.relative_to(ROOT).as_posix(),) + split_fm(
        p.read_text(encoding="utf-8", errors="replace")) for p in files]

    def tier(mode):
        out = []
        for rel, fm, body in parts:
            if mode == "full":
                out.append(f"{PAGE}{rel} =====\n---\n{fm}\n---\n{body}")
            elif mode == "claims":
                keep = [l for l in fm.split("\n") if not re.match(
                    r"^(date_created|date_modified|tags|aliases|importance|title):", l)]
                out.append(f"{PAGE}{rel} =====\n{chr(10).join(keep)}\n{body}")
            else:
                out.append(f"{PAGE}{rel} =====\n{body}")
        return "".join(out)

    cs = codecs(best=True)
    short = {"plain": "plain", "gzip -9": "gzip", "xz -9e (text-tuned)": "xz",
             "brotli q11": "brotli", "PPMd H order-16": "ppmd"}
    w = 11
    print(f"{len(files)} pages · {human(source_bytes)} on disk\n")
    print(f"{'tier':<44}" + "".join(f"{short.get(l, l):>{w}}" for _, l, _, _ in cs))
    print("-" * (44 + w * len(cs)))
    for mode, label, lossy in [("full", "everything (lossless)", False),
                               ("claims", "− mechanical metadata", True),
                               ("body", "bodies only, no frontmatter", True)]:
        for variant, suffix in ((tier(mode), ""), (compact(tier(mode)), " + path symbols")):
            b = variant.encode()
            row = "".join(f"{human(len(enc(b))):>{w}}" for _, _, enc, _ in cs)
            print(f"{label + suffix:<44}{row}{'  (lossy)' if lossy else ''}")
    print("\nRead this table as: compression is the lever; path symbols and")
    print("metadata-stripping are not. Ship the lossless tier, compressed.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
