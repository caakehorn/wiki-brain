#!/usr/bin/env python3
"""wiki-digest — generate human-facing reading aids from the wiki.

Writes three files at the repo root, all generated-but-COMMITTED (like llm/):

  RECENT.md    what changed lately, newest first, with the reason
  OPEN.md      every unresolved contradiction, gap and prediction in one place
  DIGEST.md    the front door: counts, altitude, and the top of both lists

Nothing here is a source of truth. Everything is derived from wiki/ frontmatter
and from the dated blocks pages already carry, so it is safe to regenerate at
any time. Run it after a content pass, alongside bin/llm-publish.

Pure stdlib, no arguments.
"""
import os
import re
from collections import defaultdict
from datetime import date, datetime, timedelta

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
WIKI = os.path.join(ROOT, "wiki")

# Dated blocks a page uses to record what happened to it.
BLOCK_RE = re.compile(
    r"\*\*(REVISED|RE-CHECKED|CORRECTED|GAP CLOSED|CONTRADICTION|DEADLINE ELAPSED)"
    r"\s*\[?(\d{4}-\d{2}-\d{2})?\]?[^*]*\*\*(?::)?\s*(.{0,240})",
    re.S,
)
CONTRA_RE = re.compile(r"^>\s*\*\*CONTRADICTION[^*]*\*\*:?\s*(.{0,400})", re.M | re.S)


def pages():
    for dirpath, _dirs, files in os.walk(WIKI):
        for f in sorted(files):
            if f.endswith(".md"):
                yield os.path.join(dirpath, f)


def split_fm(text):
    if not text.startswith("---"):
        return "", text
    end = text.find("\n---", 3)
    if end == -1:
        return "", text
    return text[3:end], text[end + 4 :]


def field(fm, name):
    m = re.search(r"^%s:\s*(.+)$" % name, fm, re.M)
    return m.group(1).strip().strip("\"'") if m else ""


def rel(path):
    return os.path.relpath(path, ROOT).replace(".md", "")


def tidy(s):
    # [[path|Label]] -> Label ; [[a/b/c]] -> c
    s = re.sub(r"\[\[[^\]|]+\|([^\]]+)\]\]", r"\1", s)
    s = re.sub(r"\[\[([^\]]+)\]\]", lambda m: m.group(1).rstrip("/").split("/")[-1], s)
    s = re.sub(r"^[ \t]*>[ \t]?", "", s, flags=re.M)   # blockquote markers
    s = re.sub(r"\s+", " ", s).strip()
    s = re.sub(r"^[-—:\s]+", "", s)
    return s


def load():
    out = []
    for p in pages():
        try:
            text = open(p, encoding="utf-8").read()
        except OSError:
            continue
        fm, body = split_fm(text)
        if not fm:
            continue
        out.append(
            {
                "path": rel(p),
                "file": p,
                "title": field(fm, "title") or os.path.basename(p)[:-3].replace("-", " "),
                "domain": field(fm, "domain"),
                "status": field(fm, "status"),
                "knowledge": field(fm, "knowledge"),
                "modified": field(fm, "date_modified"),
                "body": body,
                "fm": fm,
            }
        )
    return out


def log_reasons():
    """Map date -> the log.md lines for that date, so RECENT can say why."""
    reasons = defaultdict(list)
    path = os.path.join(ROOT, "log.md")
    if not os.path.exists(path):
        return reasons
    for line in open(path, encoding="utf-8"):
        m = re.match(r"^##\s*\[(\d{4}-\d{2}-\d{2})\]\s*(.+)$", line.strip())
        if m:
            reasons[m.group(1)].append(m.group(2).strip())
    return reasons


def newest_block(body):
    """The most recent dated block on a page, as (kind, date, gist)."""
    best = None
    for m in BLOCK_RE.finditer(body):
        kind, when, gist = m.group(1), m.group(2) or "", m.group(3)
        if best is None or when > best[1]:
            best = (kind, when, tidy(gist))
    return best


def write_recent(entries, reasons):
    by_date = defaultdict(list)
    for e in entries:
        if e["modified"]:
            by_date[e["modified"]].append(e)

    out = [
        "# Recent Activity",
        "",
        "_Generated by `bin/wiki-digest`. Do not hand-edit — rerun the tool._",
        "",
        "What changed, newest first, by the `date_modified` each page carries. The",
        "**why** column is the page's own most recent dated block (`REVISED`,",
        "`RE-CHECKED`, `CORRECTED`, `GAP CLOSED`, `CONTRADICTION`) where it has one —",
        "so a page that recorded why it moved says so here, and one that did not is",
        "simply listed.",
        "",
    ]

    for when in sorted(by_date, reverse=True)[:20]:
        group = sorted(by_date[when], key=lambda e: (e["domain"], e["path"]))
        out.append("## %s — %d page%s" % (when, len(group), "" if len(group) == 1 else "s"))
        out.append("")
        for line in reasons.get(when, []):
            out.append("- **Session log:** %s" % line)
        if reasons.get(when):
            out.append("")
        out.append("| Page | Domain | What moved |")
        out.append("|---|---|---|")
        for e in group:
            blk = newest_block(e["body"])
            why = ""
            if blk and blk[1] == when:
                why = "**%s** — %s" % (blk[0], blk[2][:200])
            elif blk:
                why = (
                    "_(carries a %s from %s)_" % (blk[0], blk[1])
                    if blk[1]
                    else "_(carries a %s)_" % blk[0]
                )
            out.append(
                "| [[%s]] | %s | %s |" % (e["path"], e["domain"] or "—", why or "—")
            )
        out.append("")

    open(os.path.join(ROOT, "RECENT.md"), "w", encoding="utf-8").write("\n".join(out) + "\n")
    return sum(len(v) for v in by_date.values())


def write_open(entries):
    contradictions, gaps, predictions = [], [], []

    for e in entries:
        body = e["body"]

        for m in CONTRA_RE.finditer(body):
            contradictions.append((e, tidy(m.group(1))[:320]))

        gs = re.search(r"^##+\s*Gaps?\b.*?$(.*?)(?=^##\s|\Z)", body, re.M | re.S)
        if gs:
            for line in re.findall(r"^-\s+(.+?)(?=\n-\s|\n\n|\Z)", gs.group(1), re.M | re.S):
                flat = tidy(line)
                if not flat or flat.startswith("~~"):
                    continue  # struck through = resolved
                if re.search(r"\b(CLOSED|RESOLVED|SETTLED)\b", flat):
                    continue
                gaps.append((e, flat[:260]))

        ps = re.search(r"^##+\s*Predictions?\b.*?$(.*?)(?=^##\s|\Z)", body, re.M | re.S)
        if ps:
            for line in re.findall(r"^\d+\.\s+(.+?)(?=\n\d+\.\s|\n\n|\Z)", ps.group(1), re.M | re.S):
                flat = tidy(line)
                if flat:
                    predictions.append((e, flat[:260]))

    out = [
        "# Open Questions",
        "",
        "_Generated by `bin/wiki-digest`. Do not hand-edit — rerun the tool._",
        "",
        "Everything the wiki currently admits it does not know, collected from the",
        "pages themselves. A gap struck through or marked CLOSED/RESOLVED/SETTLED is",
        "filtered out, so this list shrinks only when something is actually settled.",
        "",
        "| | count |",
        "|---|---|",
        "| Live contradictions | %d |" % len(contradictions),
        "| Open gaps | %d |" % len(gaps),
        "| Standing predictions | %d |" % len(predictions),
        "",
        "## Live contradictions",
        "",
        "Pages making incompatible claims, held rather than resolved. These are the",
        "highest-value items here: each one is a place the corpus knows it is wrong",
        "somewhere and has not yet found out where.",
        "",
    ]
    for e, gist in sorted(contradictions, key=lambda x: x[0]["path"]):
        out.append("- **[[%s]]** — %s" % (e["path"], gist))
    if not contradictions:
        out.append("_None recorded._")

    out += [
        "",
        "## Standing predictions",
        "",
        "Falsifiable claims awaiting a verdict. Scoring one of these is the cheapest",
        "new knowledge available, because no new source is required.",
        "",
    ]
    for e, gist in sorted(predictions, key=lambda x: x[0]["path"]):
        out.append("- **[[%s]]** — %s" % (e["path"], gist))
    if not predictions:
        out.append("_None recorded._")

    out += ["", "## Open gaps, by domain", ""]
    by_dom = defaultdict(list)
    for e, gist in gaps:
        by_dom[e["domain"] or "—"].append((e, gist))
    for dom in sorted(by_dom):
        out.append("### %s (%d)" % (dom, len(by_dom[dom])))
        out.append("")
        for e, gist in sorted(by_dom[dom], key=lambda x: x[0]["path"]):
            out.append("- **[[%s]]** — %s" % (e["path"], gist))
        out.append("")

    open(os.path.join(ROOT, "OPEN.md"), "w", encoding="utf-8").write("\n".join(out) + "\n")
    return len(contradictions), len(gaps), len(predictions)


def write_digest(entries, touched, counts, reasons):
    contra, gaps, preds = counts
    doms = defaultdict(int)
    stat = defaultdict(int)
    for e in entries:
        doms[e["domain"] or "—"] += 1
        stat[e["status"] or "—"] += 1

    synth = [e for e in entries if "synthesizes:" in e["fm"]]
    today = date.today().isoformat()
    recent_cut = (datetime.now() - timedelta(days=14)).date().isoformat()
    fresh = [e for e in entries if e["modified"] >= recent_cut]

    out = [
        "# Wiki Digest",
        "",
        "_Generated by `bin/wiki-digest` on %s. Do not hand-edit._" % today,
        "",
        "The front door for a human. [index.md](index.md) is the navigational map;",
        "this is the state of the thing.",
        "",
        "- **[RECENT.md](RECENT.md)** — what changed lately and why",
        "- **[OPEN.md](OPEN.md)** — every unresolved contradiction, gap and prediction",
        "",
        "## Size",
        "",
        "| | |",
        "|---|---|",
        "| Pages | %d |" % len(entries),
        "| Pages touched in the last 14 days | %d |" % len(fresh),
        "| Pages reasoning from other pages (`synthesizes:`) | %d |" % len(synth),
        "| Live contradictions | %d |" % contra,
        "| Open gaps | %d |" % gaps,
        "| Standing predictions | %d |" % preds,
        "",
        "## By domain",
        "",
        "| Domain | Pages |",
        "|---|---|",
    ]
    for d in sorted(doms, key=lambda k: -doms[k]):
        out.append("| %s | %d |" % (d, doms[d]))

    out += ["", "## By status", "", "| Status | Pages |", "|---|---|"]
    for s in sorted(stat, key=lambda k: -stat[k]):
        out.append("| %s | %d |" % (s, stat[s]))

    out += [
        "",
        "## The last few days",
        "",
    ]
    for when in sorted({e["modified"] for e in entries if e["modified"]}, reverse=True)[:5]:
        n = len([e for e in entries if e["modified"] == when])
        out.append("**%s** — %d page%s" % (when, n, "" if n == 1 else "s"))
        for line in reasons.get(when, []):
            out.append("  - %s" % line)
        out.append("")

    out += [
        "## Pages that reason from other pages",
        "",
        "The altitude of the wiki — everything here was built on top of something",
        "else in it, and `bin/wiki-climb check` will flag any of them whose premises",
        "have moved since.",
        "",
    ]
    for e in sorted(synth, key=lambda e: e["path"]):
        n = len(re.findall(r"^\s+-\s+wiki/", re.search(r"synthesizes:\s*\n((?:\s+-\s+.*\n)+)", e["fm"]).group(1), re.M))
        out.append("- [[%s]] — %d premise%s" % (e["path"], n, "" if n == 1 else "s"))

    open(os.path.join(ROOT, "DIGEST.md"), "w", encoding="utf-8").write("\n".join(out) + "\n")


def main():
    entries = load()
    reasons = log_reasons()
    touched = write_recent(entries, reasons)
    counts = write_open(entries)
    write_digest(entries, touched, counts, reasons)
    print(
        "wiki-digest: %d pages -> DIGEST.md, RECENT.md, OPEN.md "
        "(%d contradictions, %d gaps, %d predictions)"
        % (len(entries), counts[0], counts[1], counts[2])
    )


if __name__ == "__main__":
    main()
